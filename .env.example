# Placeholder only. Later auth must treat the literal replace-me as invalid if it is copied unchanged into a running service.
CONFIG_SERVICE_TOKEN=replace-me
# Base URL the editor server will use for the private configuration service.
CONFIG_SERVICE_URL=http://127.0.0.1:4001
# Postgres URL for the configuration service. The health route does not connect.
DATABASE_URL=postgres://reactiv:reactiv@127.0.0.1:5432/reactiv
# Test database URL. Repository tests create this database when it is missing.
DATABASE_URL_TEST=postgres://reactiv:reactiv@127.0.0.1:5432/reactiv_test
# Server-selected demo tenant. The browser does not choose this value.
DEMO_TENANT_ID=tenant_demo
# Server-selected demo configuration id.
DEMO_CONFIGURATION_ID=cfg_demo
# Bind address for the configuration service. Keep this on loopback.
CONFIG_SERVICE_HOST=127.0.0.1
# Port for the configuration service.
CONFIG_SERVICE_PORT=4001
# Dev server port for the editor. The Vite config reads this when it is set.
EDITOR_PORT=5173
